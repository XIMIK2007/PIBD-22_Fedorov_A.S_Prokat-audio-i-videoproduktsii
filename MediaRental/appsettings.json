{
  "ConnectionStrings": {
    "MediaRental": "Host=localhost;Port=5432;Database=media_rental_lab2;Username=postgres"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/media-rental-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
